{
  "version": 8,
  "name": "MotoNav High-Contrast Motorcycle Style",
  "metadata": {
    "motonav:category": "motorcycle_navigation"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://file:///data/user/0/com.motonav/files/maps/west_bengal.pmtiles"
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#121212"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1a365d"
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": {
        "fill-color": "#14301d"
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#333333",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 4]
      }
    },
    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#f59e0b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 2, 16, 8]
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 2, 16, 10]
      }
    },
    {
      "id": "road_motorway_trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#ef4444",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2, 16, 12]
      }
    },
    {
      "id": "road_labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 16, 16],
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    },
    {
      "id": "poi_petrol",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["==", "subclass", "fuel"],
      "paint": {
        "circle-radius": 6,
        "circle-color": "#10b981",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name:latin}",
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 14, 20]
      },
      "paint": {
        "text-color": "#e2e8f0",
        "text-halo-color": "#000000",
        "text-halo-width": 2.5
      }
    }
  ]
}
